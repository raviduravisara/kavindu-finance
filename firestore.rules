rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Only the signed-in owner may touch users/{userId} and everything under it.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // The document must have exactly these fields: none missing, none extra.
    function hasExactly(fields) {
      return incoming().keys().hasAll(fields) && incoming().keys().hasOnly(fields);
    }

    // createdAt is set once, when the document is created, and never changes afterwards.
    function keepsCreatedAt() {
      return incoming().createdAt == existing().createdAt;
    }

    // Money is a whole number of cents (Long in the app), never a decimal. The upper limit
    // (LKR 10 billion) catches typing mistakes such as extra zeros.
    function isPositiveCents(v) { return v is int && v > 0 && v <= 1000000000000; }
    function isCentsOrZero(v) { return v is int && v >= 0 && v <= 1000000000000; }
    function isSignedCents(v) { return v is int && v >= -1000000000000 && v <= 1000000000000; }
    function isSignedCentsOrNull(v) { return v == null || isSignedCents(v); }

    function isCurrency(v) { return v in ['LKR', 'USD', 'USDT']; }
    // "yyyy-MM-dd" text between 2000 and 2100 (text in this format sorts like dates).
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && v >= '2000-01-01' && v <= '2100-12-31';
    }
    function isDateOrNull(v) { return v == null || isDate(v); }
    function isName(v) { return v is string && v.size() > 0 && v.size() <= 100; }
    function isTextOrNull(v) { return v == null || (v is string && v.size() <= 500); }
    function isIdOrNull(v) { return v == null || (v is string && v.size() > 0); }
    function isTimestamp(v) { return v is int && v > 0; }
    function isCycleDay(v) { return v is int && v >= 1 && v <= 28; }

    // ---------- Field checks for each document type ----------

    function validProfile() {
      let d = incoming();
      return hasExactly(['email', 'cycleStartDay', 'baseCurrency', 'lastChannel', 'lastAccount', 'createdAt'])
        && d.email is string
        && d.email.lower() == request.auth.token.email.lower() // the profile belongs to this login
        && isCycleDay(d.cycleStartDay)
        && isCurrency(d.baseCurrency)
        && isTextOrNull(d.lastChannel)
        && isTextOrNull(d.lastAccount)
        && isTimestamp(d.createdAt);
    }

    function validIncome() {
      let d = incoming();
      return hasExactly(['source', 'amountCents', 'currency', 'lkrAmountCents', 'rateCentsPerUnit', 'date',
                         'note', 'projectId', 'milestoneId', 'createdAt'])
        && d.source in ['SALARY', 'FREELANCE', 'ADSENSE', 'OTHER']
        && isPositiveCents(d.amountCents)
        && isCurrency(d.currency)
        && isPositiveCents(d.lkrAmountCents)
        && isPositiveCents(d.rateCentsPerUnit)
        // LKR income: the amount received is the amount itself, at a rate of LKR 1.00 (100 cents).
        && (d.currency != 'LKR' || (d.lkrAmountCents == d.amountCents && d.rateCentsPerUnit == 100))
        && isDate(d.date)
        && isTextOrNull(d.note)
        && isIdOrNull(d.projectId)
        && isIdOrNull(d.milestoneId)
        && isTimestamp(d.createdAt);
    }

    function validExpense(docId) {
      let d = incoming();
      return hasExactly(['amountCents', 'currency', 'date', 'categoryId', 'categoryType', 'channel', 'account',
                         'note', 'origin', 'recurringItemId', 'isConfirmed', 'createdAt'])
        && isPositiveCents(d.amountCents)
        && isCurrency(d.currency)
        && isDate(d.date)
        && isName(d.categoryId)
        && d.categoryType in ['COMMITTED', 'DISCRETIONARY']
        && isName(d.channel)
        && isName(d.account)
        && isTextOrNull(d.note)
        && d.origin in ['MANUAL', 'RECURRING', 'BALANCE_CHECK']
        // A recurring entry must use its fixed ID "<recurringItemId>_<date>", so it can never be added twice.
        && (d.origin != 'RECURRING' || (d.recurringItemId is string && docId == d.recurringItemId + '_' + d.date))
        && isIdOrNull(d.recurringItemId)
        && d.isConfirmed is bool
        && isTimestamp(d.createdAt);
    }

    function validCategory() {
      let d = incoming();
      return hasExactly(['name', 'type', 'sortOrder', 'createdAt'])
        && isName(d.name)
        && d.type in ['COMMITTED', 'DISCRETIONARY']
        && d.sortOrder is int
        && isTimestamp(d.createdAt);
    }

    function validRecurringItem() {
      let d = incoming();
      return hasExactly(['name', 'amountCents', 'categoryId', 'dayOfMonth', 'isEstimate', 'isSubscription',
                         'isActive', 'lastReviewedDate', 'createdAt'])
        && isName(d.name)
        && isPositiveCents(d.amountCents)
        && isName(d.categoryId)
        && isCycleDay(d.dayOfMonth)
        && d.isEstimate is bool
        && d.isSubscription is bool
        && d.isActive is bool
        && isDateOrNull(d.lastReviewedDate)
        && isTimestamp(d.createdAt);
    }

    function validGoal() {
      let d = incoming();
      return hasExactly(['name', 'targetCents', 'deadline', 'startingSavingsCents', 'startDate', 'createdAt'])
        && isName(d.name)
        && isPositiveCents(d.targetCents)
        && isDate(d.deadline)
        && isCentsOrZero(d.startingSavingsCents)
        && isDate(d.startDate)
        && d.deadline > d.startDate // the deadline comes after the start
        && isTimestamp(d.createdAt);
    }

    function validFreelanceProject() {
      let d = incoming();
      return hasExactly(['clientName', 'projectName', 'createdAt'])
        && isName(d.clientName)
        && isName(d.projectName)
        && isTimestamp(d.createdAt);
    }

    function validMilestone() {
      let d = incoming();
      return hasExactly(['projectId', 'title', 'amountCents', 'currency', 'dueDate', 'status', 'incomeId', 'createdAt'])
        && isName(d.projectId)
        && isName(d.title)
        && isPositiveCents(d.amountCents)
        && isCurrency(d.currency)
        && isDate(d.dueDate)
        && d.status in ['PENDING', 'RECEIVED', 'CANCELLED']
        && isIdOrNull(d.incomeId)
        // Only a received milestone points to its income entry, so every payment matches a project.
        && ((d.status == 'RECEIVED') == (d.incomeId != null))
        && isTimestamp(d.createdAt);
    }

    function validCryptoTransfer() {
      let d = incoming();
      return hasExactly(['direction', 'amountCents', 'date', 'note', 'createdAt'])
        && d.direction in ['INTO_BINANCE', 'OUT_OF_BINANCE']
        && isPositiveCents(d.amountCents)
        && isDate(d.date)
        && isTextOrNull(d.note)
        && isTimestamp(d.createdAt);
    }

    function validBalanceCheck() {
      let d = incoming();
      return hasExactly(['date', 'bankBalanceCents', 'walletCashCents', 'isStartingPoint', 'expectedCents',
                         'gapCents', 'resultExpenseId', 'resultIncomeId', 'createdAt'])
        && isDate(d.date)
        && isSignedCents(d.bankBalanceCents)
        && isCentsOrZero(d.walletCashCents)
        && d.isStartingPoint is bool
        && isSignedCentsOrNull(d.expectedCents)
        && isSignedCentsOrNull(d.gapCents)
        && isIdOrNull(d.resultExpenseId)
        && isIdOrNull(d.resultIncomeId)
        && isTimestamp(d.createdAt);
    }

    // ---------- Rules ----------
    // Owner only. Create: the data must pass its check. Update: the same check, and createdAt stays the same.
    // Anything not listed here (another user's data, unknown collections) is denied.

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile() && keepsCreatedAt() && incoming().email == existing().email;
      // No delete: removing the profile would break the app for this user.

      match /incomes/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validIncome();
        allow update: if isOwner(userId) && validIncome() && keepsCreatedAt();
      }
      match /expenses/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validExpense(docId);
        allow update: if isOwner(userId) && validExpense(docId) && keepsCreatedAt();
      }
      match /categories/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validCategory();
        allow update: if isOwner(userId) && validCategory() && keepsCreatedAt();
      }
      match /recurringItems/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validRecurringItem();
        allow update: if isOwner(userId) && validRecurringItem() && keepsCreatedAt();
      }
      match /goals/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validGoal();
        allow update: if isOwner(userId) && validGoal() && keepsCreatedAt();
      }
      match /freelanceProjects/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validFreelanceProject();
        allow update: if isOwner(userId) && validFreelanceProject() && keepsCreatedAt();
      }
      match /milestones/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validMilestone();
        allow update: if isOwner(userId) && validMilestone() && keepsCreatedAt();
      }
      match /cryptoTransfers/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validCryptoTransfer();
        allow update: if isOwner(userId) && validCryptoTransfer() && keepsCreatedAt();
      }
      match /balanceChecks/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validBalanceCheck();
        // No update or delete: past checks are the history each new check is measured against.
      }
    }
  }
}
