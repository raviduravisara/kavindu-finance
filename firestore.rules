rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Only the signed-in owner may touch users/{userId} and everything under it.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // The document must have exactly these fields: none missing, none extra.
    function hasExactly(fields) {
      return incoming().keys().hasAll(fields) && incoming().keys().hasOnly(fields);
    }

    // Money is a whole number of cents (Long in the app), never a decimal.
    function isPositiveCents(v) { return v is int && v > 0; }
    function isCentsOrZero(v) { return v is int && v >= 0; }
    function isCentsOrNull(v) { return v == null || v is int; }

    function isCurrency(v) { return v in ['LKR', 'USD', 'USDT']; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isDateOrNull(v) { return v == null || isDate(v); }
    function isName(v) { return v is string && v.size() > 0 && v.size() <= 100; }
    function isTextOrNull(v) { return v == null || (v is string && v.size() <= 500); }
    function isIdOrNull(v) { return v == null || (v is string && v.size() > 0); }
    function isTimestamp(v) { return v is int && v > 0; }
    function isCycleDay(v) { return v is int && v >= 1 && v <= 28; }

    // ---------- Field checks for each document type ----------

    function validProfile() {
      let d = incoming();
      return hasExactly(['email', 'cycleStartDay', 'baseCurrency', 'lastChannel', 'lastAccount', 'createdAt'])
        && d.email is string
        && isCycleDay(d.cycleStartDay)
        && isCurrency(d.baseCurrency)
        && isTextOrNull(d.lastChannel)
        && isTextOrNull(d.lastAccount)
        && isTimestamp(d.createdAt);
    }

    function validIncome() {
      let d = incoming();
      return hasExactly(['source', 'amountCents', 'currency', 'lkrAmountCents', 'rateCentsPerUnit', 'date',
                         'note', 'projectId', 'milestoneId', 'createdAt'])
        && d.source in ['SALARY', 'FREELANCE', 'ADSENSE', 'OTHER']
        && isPositiveCents(d.amountCents)
        && isCurrency(d.currency)
        && isPositiveCents(d.lkrAmountCents)
        && isPositiveCents(d.rateCentsPerUnit)
        && isDate(d.date)
        && isTextOrNull(d.note)
        && isIdOrNull(d.projectId)
        && isIdOrNull(d.milestoneId)
        && isTimestamp(d.createdAt);
    }

    function validExpense() {
      let d = incoming();
      return hasExactly(['amountCents', 'currency', 'date', 'categoryId', 'categoryType', 'channel', 'account',
                         'note', 'origin', 'recurringItemId', 'isConfirmed', 'createdAt'])
        && isPositiveCents(d.amountCents)
        && isCurrency(d.currency)
        && isDate(d.date)
        && isName(d.categoryId)
        && d.categoryType in ['COMMITTED', 'DISCRETIONARY']
        && isName(d.channel)
        && isName(d.account)
        && isTextOrNull(d.note)
        && d.origin in ['MANUAL', 'RECURRING', 'BALANCE_CHECK']
        && isIdOrNull(d.recurringItemId)
        && d.isConfirmed is bool
        && isTimestamp(d.createdAt);
    }

    function validCategory() {
      let d = incoming();
      return hasExactly(['name', 'type', 'sortOrder', 'createdAt'])
        && isName(d.name)
        && d.type in ['COMMITTED', 'DISCRETIONARY']
        && d.sortOrder is int
        && isTimestamp(d.createdAt);
    }

    function validRecurringItem() {
      let d = incoming();
      return hasExactly(['name', 'amountCents', 'categoryId', 'dayOfMonth', 'isEstimate', 'isSubscription',
                         'isActive', 'lastReviewedDate', 'createdAt'])
        && isName(d.name)
        && isPositiveCents(d.amountCents)
        && isName(d.categoryId)
        && isCycleDay(d.dayOfMonth)
        && d.isEstimate is bool
        && d.isSubscription is bool
        && d.isActive is bool
        && isDateOrNull(d.lastReviewedDate)
        && isTimestamp(d.createdAt);
    }

    function validGoal() {
      let d = incoming();
      return hasExactly(['name', 'targetCents', 'deadline', 'startingSavingsCents', 'startDate', 'createdAt'])
        && isName(d.name)
        && isPositiveCents(d.targetCents)
        && isDate(d.deadline)
        && isCentsOrZero(d.startingSavingsCents)
        && isDate(d.startDate)
        && isTimestamp(d.createdAt);
    }

    function validFreelanceProject() {
      let d = incoming();
      return hasExactly(['clientName', 'projectName', 'createdAt'])
        && isName(d.clientName)
        && isName(d.projectName)
        && isTimestamp(d.createdAt);
    }

    function validMilestone() {
      let d = incoming();
      return hasExactly(['projectId', 'title', 'amountCents', 'currency', 'dueDate', 'status', 'incomeId', 'createdAt'])
        && isName(d.projectId)
        && isName(d.title)
        && isPositiveCents(d.amountCents)
        && isCurrency(d.currency)
        && isDate(d.dueDate)
        && d.status in ['PENDING', 'RECEIVED', 'CANCELLED']
        && isIdOrNull(d.incomeId)
        && isTimestamp(d.createdAt);
    }

    function validCryptoTransfer() {
      let d = incoming();
      return hasExactly(['direction', 'amountCents', 'date', 'note', 'createdAt'])
        && d.direction in ['INTO_BINANCE', 'OUT_OF_BINANCE']
        && isPositiveCents(d.amountCents)
        && isDate(d.date)
        && isTextOrNull(d.note)
        && isTimestamp(d.createdAt);
    }

    function validBalanceCheck() {
      let d = incoming();
      return hasExactly(['date', 'bankBalanceCents', 'walletCashCents', 'isStartingPoint', 'expectedCents',
                         'gapCents', 'resultExpenseId', 'resultIncomeId', 'createdAt'])
        && isDate(d.date)
        && d.bankBalanceCents is int
        && isCentsOrZero(d.walletCashCents)
        && d.isStartingPoint is bool
        && isCentsOrNull(d.expectedCents)
        && isCentsOrNull(d.gapCents)
        && isIdOrNull(d.resultExpenseId)
        && isIdOrNull(d.resultIncomeId)
        && isTimestamp(d.createdAt);
    }

    // ---------- Rules ----------
    // Read and delete: owner only. Create and update: owner only, and the data must pass its check.
    // Anything not listed here (another user's data, unknown collections) is denied.

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validProfile();

      match /incomes/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validIncome();
      }
      match /expenses/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validExpense();
      }
      match /categories/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCategory();
      }
      match /recurringItems/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validRecurringItem();
      }
      match /goals/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validGoal();
      }
      match /freelanceProjects/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validFreelanceProject();
      }
      match /milestones/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validMilestone();
      }
      match /cryptoTransfers/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCryptoTransfer();
      }
      match /balanceChecks/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validBalanceCheck();
      }
    }
  }
}
